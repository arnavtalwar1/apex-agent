# ==============================================================================
# APEX Agent - Environment Configuration Template (.env.example)
# Copy this file to .env and provide your own environment variables.
# Never commit the actual .env file with real secrets to source control.
# ==============================================================================

# LLM Provider API Keys (provide at least one)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
TAVILY_API_KEY=your_tavily_search_api_key_here

# Model Selection (e.g., gpt-4o-mini, gpt-4o, llama-3.3-70b-versatile, etc.)
MODEL_NAME=gpt-4o-mini

# Database Configuration
# Local SQLite: sqlite+aiosqlite:///./apex.db
# Cloud PostgreSQL (Render/Supabase/Neon/Railway): postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./apex.db

# Redis State Checkpointer (optional: falls back to in-memory MemorySaver if omitted/unreachable)
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_secret_string_minimum_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Execution Sandbox & Safety
SECURE_SANDBOX_ENABLED=True
MAX_CODE_TIMEOUT_SECONDS=30
MAX_CODE_OUTPUT_CHARS=25000
REQUIRE_APPROVAL_FOR_CODE_EXECUTION=False

# Governance, Cost Limits & Observability
MAX_COST_PER_TASK_USD=0.50
ENABLE_OBSERVABILITY_TRACING=True

# Production CORS & Host Security
ALLOWED_ORIGINS=*
ALLOWED_HOSTS=*

# Application Configuration
APP_NAME=APEX Agent
DEBUG=False
